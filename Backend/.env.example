# =============================================================================
# NewsArchive RAG System — Template variabili d'ambiente (SENZA SEGRETI)
# =============================================================================
# Copia questo file in .env e compila i valori reali.
# Il file .env NON deve essere committato su Git (.gitignore lo esclude).
#
# Recupera i valori con i comandi Azure CLI documentati in Azure/README.md.
# =============================================================================

# ---------------------------------------------------------------------------
# Azure Blob Storage
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="articles-raw"

# ---------------------------------------------------------------------------
# Azure Cosmos DB (NoSQL, Serverless)
# ---------------------------------------------------------------------------
COSMOS_ENDPOINT="https://<cosmos-account-name>.documents.azure.com:443/"
COSMOS_PRIMARY_KEY=""
COSMOS_DATABASE_NAME="newsdb"
COSMOS_ARTICLES_CONTAINER="articles"
COSMOS_CHUNKS_CONTAINER="chunks"

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT="https://<search-service-name>.search.windows.net"
AZURE_SEARCH_ADMIN_KEY=""
AZURE_SEARCH_INDEX_NAME="news-index"

# ---------------------------------------------------------------------------
# Azure OpenAI Service
# Assicurarsi di aver distribuito manualmente i modelli via Azure AI Studio
# prima di avviare il backend (vedi Azure/README.md).
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT="https://<openai-account-name>.openai.azure.com/"
AZURE_OPENAI_KEY=""
AZURE_OPENAI_API_VERSION="2024-02-01"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# ---------------------------------------------------------------------------
# Azure Container Registry
# ---------------------------------------------------------------------------
ACR_LOGIN_SERVER="<acr-name>.azurecr.io"
ACR_USERNAME="<acr-name>"
ACR_PASSWORD=""

# ---------------------------------------------------------------------------
# FastAPI — configurazione applicazione
# ---------------------------------------------------------------------------
APP_ENV="development"
LOG_LEVEL="INFO"
